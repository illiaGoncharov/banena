# Copy to deploy.env (gitignored via .env* / keep local) and fill in.
# Or export these in the shell before running npm scripts.

# Cloudflare API token: Zone.DNS Edit + Zone Settings Edit for banena.ru
CLOUDFLARE_API_TOKEN=
# Optional — auto-resolved by zone name if empty
CLOUDFLARE_ZONE_ID=

# IP from Beget / Timeweb / REG.RU hosting panel (for A records)
HOSTING_IP=

# FTP from hosting panel
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=/public_html
FTP_PORT=21
# FTP_SSL=1
